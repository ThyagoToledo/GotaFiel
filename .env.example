# Neon Postgres. Use a mesma variavel no projeto da Vercel.
DATABASE_URL="postgresql://usuario:senha@ep-xxxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Token do armazenamento privado de imagens criado no Vercel Blob.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Identificacao opcional do ambiente.
APP_ENV="development"
